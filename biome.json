{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/*.md"]
  },
  "plugins": [
    {
      "path": "./biome-plugins/no-device-time-zone.grit",
      "includes": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "packages/**/*.ts",
        "packages/**/*.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!packages/core/src/central-time.ts",
        "!apps/mobile/utils/date.ts"
      ]
    },
    {
      "path": "./biome-plugins/no-icon-barrel.grit",
      "includes": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "packages/**/*.tsx"]
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredDependencies": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            "hooks": [
              {
                "name": "useEffectEvent",
                "stableResult": true
              }
            ]
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useExhaustiveSwitchCases": "error",
        "useTailwindSortedClasses": {
          "level": "warn",
          "fix": "safe",
          "options": {}
        }
      },
      "suspicious": {
        "noDoubleEquals": "error",
        "noExplicitAny": "error",
        "noFocusedTests": "error",
        "noImplicitAnyLet": "error",
        "noSkippedTests": "error",
        "noTsIgnore": "error",
        "noVar": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": []
          }
        }
      },
      "style": {
        "noEnum": "error",
        "noInferrableTypes": "error",
        "noNamespace": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noUselessElse": "error",
        "noYodaExpression": "error",
        "useConsistentArrayType": "error",
        "useConst": "error",
        "useExportType": "error",
        "useForOf": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "useTemplate": "error",
        "useThrowOnlyError": "error",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 500
          }
        }
      },
      "complexity": {
        "noUselessFragments": "error",
        "noUselessStringConcat": "error",
        "noUselessUndefinedInitialization": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "yaml": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/dashboard/components/dashboard/locations/add-location-modal.tsx",
        "apps/dashboard/components/dashboard/locations/location-image-field.tsx",
        "apps/dashboard/components/dashboard/locations/meal-times-fields.tsx",
        "apps/dashboard/components/dashboard/locations/service-hours-fields.tsx"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noImgElement": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/dashboard/components/dashboard/changelog/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/global.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noReactNativeRawText": {
              "level": "error",
              "options": {
                "skip": ["NativeTabs.Trigger.Label", "Link.MenuAction"]
              }
            }
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "expo-haptics": "Use the helpers in ~/utils/haptics so every interaction gets the same feedback.",
                  "@supabase/supabase-js": "Screens read the SQLite cache through hooks. Only services/ talks to Supabase; add the table to the sync instead.",
                  "react-native": {
                    "importNames": ["Text", "TextInput", "Image", "ImageBackground"],
                    "message": "Use Text or TextInput from ~/components/ui/Text so every label uses the shared type scale, and Image from ~/components/ui/Image (expo-image) for caching and the shared styling."
                  },
                  "date-fns": "Dates go through ~/utils/date so every day and time is computed in Central time.",
                  "date-fns-tz": "Dates go through ~/utils/date so every day and time is computed in Central time."
                },
                "patterns": [
                  {
                    "group": ["**/utils/supabase"],
                    "message": "Screens read the SQLite cache through hooks. Only services/ talks to Supabase; add the table to the sync instead."
                  }
                ]
              }
            }
          },
          "suspicious": {
            "noConsole": {
              "level": "error",
              "options": {
                "allow": []
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/services/**", "apps/mobile/utils/supabase.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "expo-haptics": "Use the helpers in ~/utils/haptics so every interaction gets the same feedback.",
                  "react-native": {
                    "importNames": ["Text", "TextInput", "Image", "ImageBackground"],
                    "message": "Use Text or TextInput from ~/components/ui/Text so every label uses the shared type scale, and Image from ~/components/ui/Image (expo-image) for caching and the shared styling."
                  },
                  "date-fns": "Dates go through ~/utils/date so every day and time is computed in Central time.",
                  "date-fns-tz": "Dates go through ~/utils/date so every day and time is computed in Central time."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/utils/haptics.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/mobile/utils/log.ts",
        "apps/dashboard/lib/log.ts",
        "apps/website/lib/log.ts",
        "apps/scraper/src/log.ts",
        "supabase/functions/_shared/log.ts",
        "scripts/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/components/ui/Text.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "expo-haptics": "Use the helpers in ~/utils/haptics so every interaction gets the same feedback.",
                  "@supabase/supabase-js": "Screens read the SQLite cache through hooks. Only services/ talks to Supabase; add the table to the sync instead.",
                  "date-fns": "Dates go through ~/utils/date so every day and time is computed in Central time.",
                  "date-fns-tz": "Dates go through ~/utils/date so every day and time is computed in Central time."
                },
                "patterns": [
                  {
                    "group": ["**/utils/supabase"],
                    "message": "Screens read the SQLite cache through hooks. Only services/ talks to Supabase; add the table to the sync instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["scripts/qa/perf/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/supabase/src/database.types.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/utils/date.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/components/ui/Image.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
