{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".node-version", "packages/tsconfig/*.json"],
  "globalPassThroughEnv": [
    "SAMPLE_TODAY",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_DEV_URL",
    "SUPABASE_DEV_ANON_KEY",
    "SUPABASE_DEV_SERVICE_KEY",
    "EXPO_ACCESS_TOKEN",
    "ADMIN_GITHUB_TOKEN",
    "ADMIN_GITHUB_REPO",
    "ADMIN_SCRAPER_WORKFLOW",
    "ADMIN_SCRAPER_REF",
    "ADMIN_POSTHOG_API_KEY",
    "ADMIN_POSTHOG_PROJECT_ID",
    "ADMIN_POSTHOG_HOST",
    "ADMIN_ASC_KEY_ID",
    "ADMIN_ASC_ISSUER_ID",
    "ADMIN_ASC_PRIVATE_KEY",
    "ADMIN_ASC_VENDOR_NUMBER",
    "ADMIN_ASC_APP_ID",
    "ADMIN_ASC_START_YEAR",
    "FIXTURE_PORT",
    "UP",
    "OUT"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "WEBSITE_BASE_PATH",
        "WEBSITE_SITE_URL",
        "WEBSITE_STATIC_EXPORT",
        "WEBSITE_SUPABASE_URL",
        "WEBSITE_SUPABASE_ANON_KEY",
        "VERCEL_ENV",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_BRANCH_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
