diff --git a/ios/RNSScreen.mm b/ios/RNSScreen.mm
index 049fd22427b2bde17fd7ca59b8de65d0ee07b4b5..56985dac2d2be3a55c46fe2d2ad0e2facfa9f4f2 100644
--- a/ios/RNSScreen.mm
+++ b/ios/RNSScreen.mm
@@ -1546,6 +1546,48 @@ Class<RCTComponentViewProtocol> RNSScreenCls(void)
   }
 }
 
+- (void)restoreNavigationBarAfterCancelledTransition
+{
+#if !TARGET_OS_TV
+  UINavigationController *navigationController = self.navigationController;
+  if (navigationController == nil || navigationController.topViewController != self ||
+      navigationController.transitionCoordinator != nil) {
+    return;
+  }
+  RNSScreenStackHeaderConfig *config = [self.screenView findHeaderConfig];
+  if (config == nil || !config.shouldHeaderBeVisible) {
+    return;
+  }
+  if (navigationController.navigationBarHidden) {
+    [navigationController setNavigationBarHidden:NO animated:NO];
+  }
+  UINavigationBar *navigationBar = navigationController.navigationBar;
+  if (navigationBar.alpha < 1.0) {
+    navigationBar.alpha = 1.0;
+  }
+  [navigationController.view setNeedsLayout];
+  [navigationController.view layoutIfNeeded];
+  [self.view setNeedsLayout];
+  [self.view layoutIfNeeded];
+#endif
+}
+
+- (void)scheduleNavigationBarRestoreAfterCancelledTransition
+{
+#if !TARGET_OS_TV
+  __weak RNSScreen *weakSelf = self;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    [weakSelf restoreNavigationBarAfterCancelledTransition];
+  });
+  for (NSNumber *delay in @[ @0.15, @0.4, @1.0 ]) {
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(delay.doubleValue * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+                     [weakSelf restoreNavigationBarAfterCancelledTransition];
+                   });
+  }
+#endif
+}
+
 - (void)viewDidAppear:(BOOL)animated
 {
   [super viewDidAppear:animated];
@@ -1555,6 +1597,7 @@ Class<RCTComponentViewProtocol> RNSScreenCls(void)
     [self.screenView notifyAppear];
     [self notifyTransitionProgress:1.0 closing:NO goingForward:_goingForward];
   } else {
+    [self scheduleNavigationBarRestoreAfterCancelledTransition];
     [self.screenView notifyGestureCancel];
   }
 
