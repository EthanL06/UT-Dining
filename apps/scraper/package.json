{
  "name": "@ut-dining/scraper",
  "version": "1.0.0",
  "private": true,
  "description": "Scrapes UT Austin dining menus, nutrition labels and allergens from FoodPro into Supabase",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/index.ts",
    "typecheck": "node ../../node_modules/tsgo/bin/tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "web-scraping",
    "university-texas",
    "dining-halls",
    "nutrition-data",
    "typescript",
    "cheerio"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "catalog:",
    "@ut-dining/core": "workspace:*",
    "cheerio": "^1.1.0",
    "p-limit": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@ut-dining/supabase": "workspace:*",
    "@ut-dining/tsconfig": "workspace:*",
    "typescript": "catalog:",
    "vitest": "^5.0.5"
  }
}
