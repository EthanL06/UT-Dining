{
  "name": "@ut-dining/scraper",
  "version": "1.0.0",
  "private": true,
  "description": "High-performance web scraper for University of Texas at Austin dining hall menus with nutrition data and allergen information",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/index.ts",
    "perf": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/performance-test.ts",
    "typecheck": "node ../../node_modules/tsgo/bin/tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "web-scraping",
    "university-texas",
    "dining-halls",
    "nutrition-data",
    "typescript",
    "cheerio",
    "performance-testing"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "catalog:",
    "cheerio": "^1.1.0",
    "p-limit": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@ut-dining/supabase": "workspace:*",
    "@ut-dining/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
