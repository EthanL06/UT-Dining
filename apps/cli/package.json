{
  "name": "@ut-dining/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Agent-friendly CLI for everything the UT Dining dashboard edits: locations, hours, app settings, support links, changelog and push notifications",
  "type": "module",
  "scripts": {
    "start": "node src/index.ts",
    "typecheck": "node ../../node_modules/tsgo/bin/tsc --noEmit",
